# Beispiel-Umgebungsvariablen für den OBS Streamer Container
# Erstelle eine Kopie dieser Datei namens .env und trage dort deine echten Werte ein.
# Die .env-Datei wird von Git ignoriert.

# --- Twitch-Einstellungen ---
STREAM_URL=rtmp://fra05.contribute.live-video.net/app/
STREAM_KEY=live_DEIN_TWITCH_KEY_HIER

# SRT-Einstellungen
# Der Port, auf dem der Server-Container auf einen eingehenden SRT-Stream wartet.
SRT_PORT=19937

# --- Websocket-Einstellungen ---
# OBS Websocket Server aktivieren (true/false)
OBS_WS_ENABLED=true
# Port für den Websocket Server
OBS_WS_PORT=4455
# Passwort für den Websocket Server (UNBEDINGT ÄNDERN!)
OBS_WS_PW=DEIN_SICHERES_PASSWORT

# --- Video-Einstellungen ---
# Auflösung des Ausgabestreams (Breite)
RESOLUTION_W=1920
# Auflösung des Ausgabestreams (Höhe)
RESOLUTION_H=1080
# Bilder pro Sekunde (FPS)
FPS=60

# --- Audio-Einstellungen ---
# Audio-Bitrate in kbit/s
AUDIO_BITRATE=160

# --- Encoder-Einstellungen ---
# Video-Bitrate in kbit/s
VIDEO_BITRATE=6000
# Encoder (z.B. x264 für CPU-Encoding)
ENCODER=x264
# x264 Preset (z.B. veryfast für guten Kompromiss aus Qualität und CPU-Last)
PRESET=veryfast
